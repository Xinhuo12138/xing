/* pages/control/control.wxss */

.page-container { min-height: 100vh; background: #f0f7f2; }

.status-bar {
  display: flex; justify-content: space-between; align-items: center;
  padding: 12rpx 24rpx; background: linear-gradient(135deg,#2d8a4e,#3a9d5c);
  color: #fff; font-size: 24rpx;
}
.status-left { display: flex; align-items: center; gap: 10rpx; }
.status-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.status-dot.online { background: #69f0ae; }
.status-dot.offline { background: #ff5252; }
.update-time { font-size: 20rpx; opacity: 0.8; }

.page-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 24rpx; background: #fff; border-bottom: 2rpx solid #e8f0ea;
}
.header-left { display: flex; align-items: center; gap: 6rpx; padding: 8rpx 16rpx 8rpx 0; }
.back-arrow { font-size: 40rpx; color: #2d8a4e; }
.back-text { font-size: 26rpx; color: #2d8a4e; }
.page-title { font-size: 32rpx; font-weight: 600; color: #1a1a1a; }
.header-right { width: 80rpx; }

.device-list { padding: 20rpx 24rpx; display: flex; flex-direction: column; gap: 16rpx; padding-bottom: 40rpx; }
.device-card { background: #fff; border-radius: 18rpx; padding: 24rpx; box-shadow: 0 4rpx 16rpx rgba(45,138,78,0.06); }
.device-main { display: flex; align-items: center; gap: 16rpx; }
.device-icon-wrap { width: 72rpx; height: 72rpx; display: flex; align-items: center; justify-content: center; background: #f0f7f2; border-radius: 16rpx; font-size: 40rpx; }
.device-middle { flex: 1; }
.device-name { font-size: 28rpx; font-weight: 600; display: block; }
.device-category { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }

.device-slider-area { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; padding-top: 14rpx; border-top: 2rpx solid #f0f7f2; }
.slider-label { font-size: 24rpx; color: #666; min-width: 50rpx; }
.device-slider-area slider { flex: 1; }
.slider-value { font-size: 24rpx; color: #2d8a4e; font-weight: 500; min-width: 52rpx; text-align: right; }

.device-mode-row { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding-top: 14rpx; border-top: 2rpx solid #f0f7f2; }
.mode-label { font-size: 24rpx; color: #666; }
.mode-btns { display: flex; gap: 12rpx; }
.mode-btn { padding: 8rpx 28rpx; border-radius: 24rpx; font-size: 24rpx; background: #f5f5f5; color: #999; border: 2rpx solid #e0e0e0; }
.mode-btn.active { background: #e8f5e9; color: #2d8a4e; border-color: #2d8a4e; font-weight: 500; }
.mode-btn:active { opacity: 0.7; }

.device-footer { margin-top: 12rpx; display: flex; justify-content: space-between; align-items: center; }
.status-tag { display: inline-block; padding: 6rpx 20rpx; border-radius: 20rpx; font-size: 22rpx; }
.status-tag.on { background: #e8f5e9; color: #2d8a4e; }
.status-tag.off { background: #f5f5f5; color: #bbb; }
.mode-status { font-size: 22rpx; color: #999; }

.cloud-status { margin-top: 10rpx; padding-top: 10rpx; border-top: 2rpx dashed #e0e0e0; display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.cloud-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.cloud-dot.on { background: #69f0ae; }
.cloud-dot.off { background: #bbb; }
.cloud-dot.none { background: #ffd54f; }
.cloud-text { font-size: 22rpx; color: #888; }
.cloud-speed { font-size: 20rpx; color: #aaa; margin-left: auto; }

/* 自动播放时段 */
.device-time-slots { margin-top: 12rpx; padding-top: 12rpx; border-top: 2rpx solid #f0f7f2; }
.time-slots-label { font-size: 22rpx; color: #888; display: block; margin-bottom: 8rpx; }
.time-slots-list { display: flex; gap: 10rpx; flex-wrap: wrap; }
.time-slot-tag { padding: 6rpx 18rpx; border-radius: 20rpx; font-size: 22rpx; background: #f3e5f5; color: #7b1fa2; border: 2rpx solid #ce93d8; font-weight: 500; }

/* 上传状态 */
.upload-status { margin: 0 24rpx 0; padding: 16rpx 20rpx; background: #1a1a2e; border-radius: 14rpx 14rpx 0 0; border-bottom: 2rpx solid #333; }
.upload-status-header { display: flex; align-items: center; gap: 10rpx; }
.upload-dot { width: 16rpx; height: 16rpx; border-radius: 50%; }
.upload-dot.sending { background: #ffd54f; animation: blink 0.5s infinite; }
.upload-dot.success { background: #69f0ae; }
.upload-dot.fail { background: #ff5252; }
.upload-text { font-size: 24rpx; font-weight: 500; }
.upload-text.sending { color: #ffd54f; }
.upload-text.success { color: #69f0ae; }
.upload-text.fail { color: #ff5252; }
.upload-time { font-size: 20rpx; color: #666; margin-left: auto; }
.upload-device { font-size: 20rpx; color: #888; display: block; margin-top: 6rpx; }
.upload-err { font-size: 20rpx; color: #ff5252; display: block; margin-top: 4rpx; }

.cmd-preview { margin: 0 24rpx 40rpx; padding: 20rpx; background: #1a1a2e; border-radius: 0 0 14rpx 14rpx; }
.cmd-preview-title { font-size: 24rpx; color: #ffd54f; display: block; margin-bottom: 12rpx; }
.cmd-preview-content { display: block; white-space: pre-wrap; font-size: 20rpx; color: #8bc34a; line-height: 1.6; }

.safe-bottom { height: 40rpx; }
