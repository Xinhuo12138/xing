/** app.wxss - 蘑菇智慧种植全局样式 */

page {
  height: 100vh;
  background-color: #f0f7f2;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #333;
  box-sizing: border-box;
}

/* 卡片容器 */
.card {
  background: #ffffff;
  border-radius: 18rpx;
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 138, 78, 0.06);
}

/* 通用按钮 */
.btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #2d8a4e, #4caf50);
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.btn-primary:active { opacity: 0.85; }

.btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 36rpx;
  background: #fff;
  color: #2d8a4e;
  border: 2rpx solid #2d8a4e;
  border-radius: 40rpx;
  font-size: 26rpx;
}
.btn-secondary:active { background: #f0f7f2; }

/* 文本省略 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
